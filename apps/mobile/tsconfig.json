{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "typeRoots": [
      "../../node_modules/@types"
    ],
    "baseUrl": ".",
    "paths": {
      "@algorithm-avengers/contracts": [
        "../../packages/contracts/src"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
