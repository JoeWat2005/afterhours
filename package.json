{
  "name": "algorithm-avengers",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile:start": "npm run start --workspace @algorithm-avengers/mobile",
    "mobile:ios": "npm run ios --workspace @algorithm-avengers/mobile",
    "mobile:android": "npm run android --workspace @algorithm-avengers/mobile",
    "mobile:web": "npm run web --workspace @algorithm-avengers/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @algorithm-avengers/mobile",
    "convex:dev": "npx convex dev",
    "convex:deploy": "npx convex deploy"
  },
  "devDependencies": {
    "convex": "1.32.0"
  }
}

