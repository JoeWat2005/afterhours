# copy this to .env and fill in any missing values
# docker compose uses this file automatically

APP_ENV=development
DATABASE_URL=postgresql+psycopg://afterhours:afterhours@localhost:5432/afterhours
REDIS_URL=redis://localhost:6379/0

# clerk auth, get these from the clerk dashboard
CLERK_ISSUER_URL=https://fair-sheepdog-79.clerk.accounts.dev

# convex realtime sync (optional, app works without it)
CONVEX_DEPLOYMENT_URL=https://shiny-parrot-956.eu-west-1.convex.cloud

# google maps api key for transit routes
GOOGLE_MAPS_API_KEY=your_google_maps_key_here
